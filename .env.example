# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Database (SQLite file path; swap for a Postgres URL if you extend the repository layer)
DATABASE_FILE=./data/dev.sqlite3

# CORS - comma-separated list is NOT used for the public widget/submission routes
# (those intentionally accept any origin, per the capstone brief). This only
# restricts the authenticated admin API if you choose to lock it down.
ADMIN_ALLOWED_ORIGIN=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_IP=20
RATE_LIMIT_MAX_PER_WIDGET=60

# Geo providers (both are free, no key required)
GEO_PROVIDER_A_URL=http://ip-api.com/json
GEO_PROVIDER_B_URL=https://ipapi.co
GEO_TIMEOUT_MS=2500

# Demo / chaos flags - flip these to true to demonstrate graceful degradation live
FORCE_GEO_PROVIDER_A_DOWN=false
FORCE_GEO_PROVIDER_B_DOWN=false
FORCE_EMAIL_FAILURE=false

# Email side-effect (fake/console by default - never required to be real)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
